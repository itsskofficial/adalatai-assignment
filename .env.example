# Settings of Invoice Collection.
#
# Copy this file to .env and fill it in. Docker Compose gives .env to the app and the
# runner (env_file), and the command line reads it too. Never commit .env: it holds secrets.
#
# Each setting says what it is for, whether it is required, and its default. A setting left
# empty takes its default. The app and the runner name every missing or wrong required
# setting when they start, all at once, and refuse to start.
#
# Settings marked "set by compose.yaml" are given to the containers by the Compose file
# itself, for the layout inside them; leave them empty here when you use Compose.

# --- Signing in to the dashboard -------------------------------------------------------

# Signs the dashboard's session cookie. Required. No default.
# Make one with: openssl rand -hex 32
INVOICE_COLLECTOR_SESSION_SECRET=

# Administrators set by the installation, separated by commas. They can always sign in and
# cannot be removed on the People screen. Required unless the People screen already lists
# someone. No default.
INVOICE_COLLECTOR_ALLOWLIST=

# The OAuth client for a web application, from the Google Cloud console (APIs & Services,
# Credentials). Its authorised redirect URIs must be <public address>/auth/callback and
# <public address>/accounts/callback. Required: these two, or the file below. No default.
INVOICE_COLLECTOR_WEB_CLIENT_ID=
INVOICE_COLLECTOR_WEB_CLIENT_SECRET=

# The same client as the JSON file the console downloads, used only when the two settings
# above are empty. Optional. Default: credentials/web-client.json at the repository root.
INVOICE_COLLECTOR_WEB_CLIENT_FILE=

# How many days Google lets a sign-in last: 7 while the OAuth app is in testing, off for a
# published app. Optional. Default: 7.
INVOICE_COLLECTOR_SIGN_IN_LIFETIME_DAYS=

# --- Where the dashboard is ------------------------------------------------------------

# The address people open the dashboard at, with no path. Sign-in comes back to it, cookies
# are marked secure when it is https, and the digest and the Google Sheet link to it.
# Optional. Default: http://localhost:8000. In production: https://<your host name>.
INVOICE_COLLECTOR_PUBLIC_URL=

# The address and port the dashboard listens on. Optional. Defaults: 127.0.0.1 and 8000.
# Set by compose.yaml (0.0.0.0 and 8000 inside the container).
INVOICE_COLLECTOR_DASHBOARD_HOST=
INVOICE_COLLECTOR_DASHBOARD_PORT=

# The folder npm run build writes, which the dashboard then serves itself. Optional.
# Default: not served (the front end has its own development server, npm run dev).
# Set by compose.yaml.
INVOICE_COLLECTOR_FRONTEND_DIR=

# --- The runner ------------------------------------------------------------------------

# Shared by the app and the runner: the app sends it with every request, so reaching the
# runner's port is not enough to start a run. Required for the runner, and for the app when
# INVOICE_COLLECTOR_RUNNER_URL is set (always in Compose). No default.
# Make one with: openssl rand -hex 32
INVOICE_COLLECTOR_RUNNER_SECRET=

# The runner's address, as the app reaches it. Optional. Default: none, and the app then
# performs runs itself. Set by compose.yaml (http://runner:8001).
INVOICE_COLLECTOR_RUNNER_URL=

# The address and port the runner listens on. Optional. Defaults: 127.0.0.1 and 8001.
# Set by compose.yaml (0.0.0.0 inside the container, on the private network only).
INVOICE_COLLECTOR_RUNNER_HOST=
INVOICE_COLLECTOR_RUNNER_PORT=

# --- Stored sign-ins and the owner account ---------------------------------------------

# Where the sign-ins of source accounts are stored. Optional.
# Default: credentials/tokens at the repository root. Set by compose.yaml (/data/tokens).
INVOICE_COLLECTOR_TOKEN_DIR=

# The owner account, whose Drive receives the PDFs and the summary sheet. Optional.
# Default: none, and nothing goes to Drive. Set it only once that account is connected on
# the Source accounts screen with Drive access: the app refuses to start, and a run stops,
# with an owner that is not signed in.
INVOICE_COLLECTOR_GOOGLE_OWNER=

# --- Models ----------------------------------------------------------------------------

# Claude reads billing documents, answers Ask your invoices, and classifies and matches when
# Jev cannot. Optional. Default: none, and then rules read documents and every document
# they read is held for review; Ask your invoices is unavailable.
ANTHROPIC_API_KEY=

# Jev classifies emails and matches vendors first when set. Optional. Default: none.
JEV_API_KEY=

# The models used, by name. Optional. Defaults: claude-haiku-4-5 for reading, classifying
# and matching; claude-sonnet-5-5 to read a doubted document again.
INVOICE_COLLECTOR_EXTRACTION_MODEL=
INVOICE_COLLECTOR_STRONGER_MODEL=
INVOICE_COLLECTOR_CLASSIFICATION_MODEL=
INVOICE_COLLECTOR_MATCHING_MODEL=

# --- The digest ------------------------------------------------------------------------

# A Slack incoming webhook (https://hooks.slack.com/...) that each run posts its digest to.
# Optional. Default: none, and no digest is sent.
INVOICE_COLLECTOR_SLACK_WEBHOOK=

# --- Sample mail -----------------------------------------------------------------------

# The folder of sample mail an administrator may put into a test mailbox from the Source
# accounts screen. Optional. Default: backend/samples, which the image carries.
INVOICE_COLLECTOR_SAMPLES_DIR=

# The sample portal's address as the runner reaches it, with no path. Portal links in sample
# mail put into a mailbox are written with it, and a run may open that one address and
# nothing else on the local network. Optional. Default: none, and portal links to the local
# network are refused. With Compose's portal profile: http://portal:8765
INVOICE_COLLECTOR_SAMPLE_PORTAL_URL=

# --- Development -----------------------------------------------------------------------

# When set to 1, the commands do not read .env themselves (the tests set it). Optional.
# Default: not set. Set by the image.
INVOICE_COLLECTOR_SKIP_DOTENV=

# --- Docker Compose --------------------------------------------------------------------
# Read by Docker Compose, not by the tool.

# The port of this machine the dashboard is published on, on localhost only. Optional.
# Default: 8000. Not used by compose.production.yaml, which publishes nothing but the proxy.
INVOICE_COLLECTOR_PUBLISHED_PORT=

# The host name the proxy gets a certificate for, with compose.production.yaml. Required
# there, and its DNS must point at this machine. No default.
INVOICE_COLLECTOR_DOMAIN=

# The address Let's Encrypt may write to about the certificate, with
# compose.production.yaml. Optional. Default: none.
INVOICE_COLLECTOR_ACME_EMAIL=
